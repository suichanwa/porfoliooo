---
interface Project {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  githubUrl: string;
  liveUrl?: string;
  stars?: number;
  forks?: number;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Same star glyph as the About page's constellation, for a consistent visual language.
const SUISEI_PATH =
  "M8 1.85C8.38 1.85 8.68 2.11 8.9 2.58L9.57 4.03C9.76 4.43 10.07 4.64 10.49 4.69L12.07 4.9C12.73 4.98 13.01 5.73 12.51 6.12L11.34 7.03C11.01 7.29 10.87 7.64 10.95 8.06L11.26 9.63C11.39 10.28 10.71 10.77 10.13 10.47L8.74 9.75C8.36 9.56 7.94 9.56 7.56 9.75L6.17 10.47C5.59 10.77 4.91 10.28 5.04 9.63L5.35 8.06C5.43 7.64 5.29 7.29 4.96 7.03L3.79 6.12C3.29 5.73 3.57 4.98 4.23 4.9L5.81 4.69C6.23 4.64 6.54 4.43 6.73 4.03L7.4 2.58C7.62 2.11 7.92 1.85 8.3 1.85H8Z";

// Real star fields are a random point process — genuine randomness produces
// uneven clumps and gaps, which is what reads as "natural" rather than
// designed. mulberry32 gives that same look but pinned to a fixed seed, so
// the scatter is identical on every load instead of reshuffling on refresh.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260731);

// Stars are now the whole UI (click one to see the project) instead of
// permanent floating text, so the only collision to avoid is icon-to-icon —
// a much looser constraint than before, so a real rejection-sampled random
// scatter works reliably instead of needing a hand-tuned base layout.
const CANVAS_W = 1100;
const CANVAS_H = 600;
const MARGIN_X = 90;
const MARGIN_Y = 30; // small vertical margin so stars spread closer to the full container height
const MIN_DIST = 190; // wide enough to keep the name labels under each star from overlapping

function placeStars(count: number) {
  const points: { x: number; y: number }[] = [];
  let attempts = 0;
  while (points.length < count && attempts < 5000) {
    attempts++;
    const candidate = {
      x: MARGIN_X + rand() * (CANVAS_W - MARGIN_X * 2),
      y: MARGIN_Y + rand() * (CANVAS_H - MARGIN_Y * 2),
    };
    if (points.every((p) => Math.hypot(p.x - candidate.x, p.y - candidate.y) >= MIN_DIST)) {
      points.push(candidate);
    }
  }
  // Fallback in the unlikely case the random walk can't fit everyone: just
  // append remaining candidates so we never silently drop a project.
  while (points.length < count) {
    points.push({
      x: MARGIN_X + rand() * (CANVAS_W - MARGIN_X * 2),
      y: MARGIN_Y + rand() * (CANVAS_H - MARGIN_Y * 2),
    });
  }
  return points;
}

// Size ranks by GitHub stars (projects already arrive sorted by stargazer
// count) — like real star magnitude, your best-known project is the
// brightest, biggest star.
const SIZE_RANKS = [58, 46, 40, 36, 32, 28];

const count = Math.min(projects.length, SIZE_RANKS.length);
const points = placeStars(count);

// Size the constellation box to the actual vertical spread of the sampled
// points (plus room for the star + label at the extremes) instead of a
// fixed height — otherwise a random draw that happens to land mid-height
// leaves a big dead gap before the next section.
const V_PAD = 70;
const minY = Math.min(...points.map((p) => p.y));
const maxY = Math.max(...points.map((p) => p.y));
const contentHeight = maxY - minY + V_PAD * 2;

const nodes = projects.slice(0, count).map((project, i) => ({
  ...project,
  x: (points[i].x / CANVAS_W) * 100,
  y: ((points[i].y - minY + V_PAD) / contentHeight) * 100,
  size: SIZE_RANKS[i],
}));

const linePoints = nodes.map((n) => `${n.x},${n.y}`).join(" ");
---

<section id="projects" class="featured-projects">
  <div class="container max-w-6xl mx-auto px-4">
    <header class="featured-projects__header">
      <span class="featured-projects__eyebrow">Featured</span>
      <h2 class="featured-projects__title text-3xl md:text-4xl font-bold">
        Projects
      </h2>
      <p class="featured-projects__subtitle">
        A small orbit of builds I keep leveling up. Click a star.
      </p>
    </header>

    <div class="pconstellation" style={`height:${contentHeight}px`}>
      <svg class="plines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline points={linePoints} />
      </svg>

      {nodes.map((n, i) => (
        <button
          type="button"
          class="pstar-btn"
          style={`left:${n.x}%; top:${n.y}%; --delay:${300 + i * 180}ms`}
          data-modal={`pmodal-${n.id}`}
          aria-label={`View ${n.title} project details`}
        >
          <span class="pstar" style={`--size:${n.size}px`}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d={SUISEI_PATH} transform="translate(0 1.8)" />
            </svg>
          </span>
          <span class="pstar-label">{n.title}</span>
        </button>
      ))}
    </div>
  </div>

  {nodes.map((n) => (
    <dialog id={`pmodal-${n.id}`} class="pmodal">
      <div class="pmodal-inner">
        <button type="button" class="pmodal-close" data-close aria-label="Close">✕</button>
        <h3 class="pmodal-title">{n.title}</h3>
        {n.description && n.description !== "No description available" && (
          <p class="pmodal-desc">{n.description}</p>
        )}
        {n.technologies && n.technologies.length > 0 && (
          <div class="pmodal-tags">
            {n.technologies.map((tech) => <span class="pmodal-tag">{tech}</span>)}
          </div>
        )}
        <div class="pmodal-meta">
          {n.stars !== undefined && <span>★ {n.stars}</span>}
          {n.forks !== undefined && <span>⑂ {n.forks}</span>}
        </div>
        <div class="pmodal-links">
          <a href={n.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          {n.liveUrl && (
            <a href={n.liveUrl} target="_blank" rel="noopener noreferrer">Live ↗</a>
          )}
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  function initProjectConstellation() {
    document.querySelectorAll<HTMLElement>(".pconstellation").forEach((c) => {
      const line = c.querySelector<SVGPolylineElement>(".plines polyline");
      if (line) {
        const len = line.getTotalLength();
        line.style.strokeDasharray = `${len}`;
        line.style.strokeDashoffset = `${len}`;
        requestAnimationFrame(() => {
          line.style.transition = "stroke-dashoffset 2s ease 0.2s";
          line.style.strokeDashoffset = "0";
        });
      }

      document.addEventListener("mousemove", (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 10;
        const y = (e.clientY / window.innerHeight - 0.5) * 10;
        c.style.transform = `translate(${x}px, ${y}px)`;
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".pstar-btn").forEach((btn) => {
      btn.onclick = () => {
        const id = btn.dataset.modal;
        if (id) (document.getElementById(id) as HTMLDialogElement | null)?.showModal();
      };
    });

    document.querySelectorAll<HTMLDialogElement>(".pmodal").forEach((dialog) => {
      dialog.onclick = (e) => {
        if (e.target === dialog) dialog.close();
      };
      dialog.querySelector<HTMLButtonElement>("[data-close]")!.onclick = () => dialog.close();
    });
  }

  initProjectConstellation();
  document.addEventListener("astro:page-load", initProjectConstellation);
</script>

<style>
  .featured-projects {
    --fp-primary: #a7b3c6;
    --fp-primary-rgb: 167, 179, 198;
    --fp-text: rgba(248, 249, 255, 0.96);
    --fp-text-muted: rgba(224, 230, 242, 0.58);
    position: relative;
    padding: 4.5rem 0;
    font-family: "Manrope", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  }

  .featured-projects .container {
    position: relative;
    z-index: 1;
  }

  .featured-projects__header {
    text-align: center;
    margin-bottom: 2.5rem;
    color: var(--fp-text);
    position: relative;
    z-index: 1;
  }

  .featured-projects__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    font-size: 0.7rem;
    color: rgba(198, 206, 222, 0.55);
    margin-bottom: 0.75rem;
  }

  .featured-projects__title {
    color: var(--fp-text);
  }

  .featured-projects__subtitle {
    margin-top: 0.75rem;
    color: var(--fp-text-muted);
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .pconstellation {
    position: relative;
    transition: transform 0.6s ease;
    will-change: transform;
  }

  .plines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .plines polyline {
    fill: none;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 0.12;
    vector-effect: non-scaling-stroke;
  }

  .pstar-btn {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: pnodeIn 1.2s ease forwards;
    animation-delay: var(--delay);
    background: none;
    border: none;
    padding: 0.5rem;
    margin: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  @keyframes pnodeIn {
    to { opacity: 1; }
  }

  .pstar {
    display: block;
    width: var(--size);
    height: var(--size);
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.3));
    animation: ptwinkle 4s ease-in-out infinite;
  }

  .pstar svg { width: 100%; height: 100%; display: block; }
  .pstar path { fill: rgba(var(--fp-primary-rgb), 0.9); }

  @keyframes ptwinkle {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.5)); }
  }

  .pstar-label {
    max-width: 6.5rem;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-align: center;
    color: rgba(220, 228, 242, 0.5);
    transition: color 0.3s ease;
  }

  .pstar-btn:hover .pstar-label,
  .pstar-btn:focus-visible .pstar-label {
    color: rgba(255, 255, 255, 0.95);
  }

  .pstar-btn:hover .pstar,
  .pstar-btn:focus-visible .pstar {
    animation: none;
    opacity: 1;
    filter: drop-shadow(0 0 16px rgba(255, 255, 255, 0.85));
    transform: scale(1.15);
  }

  .pstar-btn:focus-visible {
    outline: 2px solid rgba(var(--fp-primary-rgb), 0.6);
    outline-offset: 4px;
    border-radius: 999px;
  }

  /* Modal */
  .pmodal {
    border: 1px solid rgba(180, 194, 214, 0.16);
    border-radius: 20px;
    padding: 0;
    background: rgba(var(--primary-bg-rgb, 10 13 24), 0.97);
    color: var(--fp-text);
    max-width: 26rem;
    width: calc(100vw - 2.5rem);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  }

  .pmodal::backdrop {
    background: rgba(2, 4, 10, 0.65);
    backdrop-filter: blur(3px);
  }

  .pmodal-inner {
    position: relative;
    padding: 2rem 1.75rem 1.75rem;
  }

  .pmodal-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid rgba(180, 194, 214, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(220, 228, 242, 0.7);
    cursor: pointer;
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pmodal-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .pmodal-title {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 700;
    padding-right: 2rem;
  }

  .pmodal-desc {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(220, 228, 242, 0.65);
  }

  .pmodal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .pmodal-tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(var(--fp-primary-rgb), 0.1);
    border: 1px solid rgba(var(--fp-primary-rgb), 0.2);
    color: rgba(220, 228, 242, 0.75);
  }

  .pmodal-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgba(var(--fp-primary-rgb), 0.85);
    margin-bottom: 1.25rem;
  }

  .pmodal-links {
    display: flex;
    gap: 0.75rem;
  }

  .pmodal-links a {
    padding: 0.55rem 1.1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: rgba(230, 236, 248, 0.92);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(180, 194, 214, 0.16);
    transition: background 0.2s ease;
  }

  .pmodal-links a:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 768px) {
    .pconstellation {
      height: auto !important;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      padding: 1rem 0;
      transform: none !important;
    }
    .plines { display: none; }
    .pstar-btn {
      position: relative;
      left: auto !important;
      top: auto !important;
      transform: none;
      opacity: 1;
      animation: none;
    }
    .pstar-btn:hover .pstar, .pstar-btn:focus-visible .pstar {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pstar-btn, .pstar {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
