---
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation";
import StarryBackground from "../components/Starry";
import FirebaseAnalytics from "../components/FirebaseAnalytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  useVoidBackground?: boolean;
  enableNeptuneTransition?: boolean;
  neptuneSectionId?: string;
}

const {
  title,
  description = "Personal portfolio, interactive planetarium, celestial visualizer, and projects by suiseika.",
  image = "/images/pfp.jpg",
  useVoidBackground = false,
  enableNeptuneTransition = false,
  neptuneSectionId = 'neptune-widget'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://suichanwa.github.io");
const ogImageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0d18" />
    <link rel="icon" type="image/jpg" href="/images/pfp.jpg" />
    <link rel="preload" as="image" href="/images/pfp.jpg" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social Embeds -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="suiseika's portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <ClientRouter />
  </head>
  <body data-theme="dark" class={useVoidBackground ? 'void-body' : 'starry-body'}>
    <FirebaseAnalytics />
    <!-- Only render StarryBackground if NOT using void background -->
    {!useVoidBackground && (
      <div transition:persist="starry-background-layer">
        <StarryBackground client:idle enableNeptuneTransition={enableNeptuneTransition} neptuneSectionId={neptuneSectionId} />
      </div>
    )}
    
    <div transition:persist="main-navigation-layer">
      <Navigation client:idle />
    </div>
    
    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Ensure proper stacking context for both layouts */
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    min-height: 100vh;
    background: #0a0d18;
  }

  /* For pages using StarryBackground */
  .starry-body {
    position: relative;
    background:
      radial-gradient(circle at 50% 18%, rgba(24, 31, 56, 0.42), transparent 44%),
      linear-gradient(180deg, #0a0d18 0%, #060912 100%);
  }

  /* For pages using VoidBackground */
  .void-body {
    position: relative;
    background: linear-gradient(180deg, #080b13 0%, #010203 100%);
  }

  .main-content {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }
</style>
