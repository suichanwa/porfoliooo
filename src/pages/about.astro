---
import BaseLayout from "../layouts/BaseLayout.astro";
import VoidBackground from "../components/VoidBackground.astro";

// Single source of truth: each star's position drives BOTH the node and the
// connecting line, so they can never drift apart.
const SUISEI_PATH =
  "M8 1.85C8.38 1.85 8.68 2.11 8.9 2.58L9.57 4.03C9.76 4.43 10.07 4.64 10.49 4.69L12.07 4.9C12.73 4.98 13.01 5.73 12.51 6.12L11.34 7.03C11.01 7.29 10.87 7.64 10.95 8.06L11.26 9.63C11.39 10.28 10.71 10.77 10.13 10.47L8.74 9.75C8.36 9.56 7.94 9.56 7.56 9.75L6.17 10.47C5.59 10.77 4.91 10.28 5.04 9.63L5.35 8.06C5.43 7.64 5.29 7.29 4.96 7.03L3.79 6.12C3.29 5.73 3.57 4.98 4.23 4.9L5.81 4.69C6.23 4.64 6.54 4.43 6.73 4.03L7.4 2.58C7.62 2.11 7.92 1.85 8.3 1.85H8Z";

const stars = [
  { x: 18, y: 30, size: 34, align: "left",   tone: "primary", text: "I'm a fullstack developer who finds peace in the quiet complexity of code." },
  { x: 38, y: 58, size: 22, align: "left",   tone: "",        text: "Like the Boötes Void, I appreciate the beauty in emptiness — clean code, minimal design, purposeful functionality." },
  { x: 56, y: 28, size: 24, align: "center", tone: "dim",     text: "When I'm not lost in code, I'm lost in GregTech New Horizons, building elaborate automation systems that mirror my development philosophy." },
  { x: 72, y: 58, size: 18, align: "right",  tone: "dimmer",  text: "TypeScript · React · Node.js — my tools for shaping the digital void." },
  { x: 86, y: 36, size: 14, align: "right",  tone: "dimmest", text: "Sometimes the most profound things exist in the spaces between." },
];

const linePoints = stars.map((s) => `${s.x},${s.y}`).join(" ");
---

<BaseLayout title="About Me | My Portfolio" useVoidBackground={true}>
  <VoidBackground starCount={350} />

  <div class="void-page">
    <span class="page-label">a constellation of me</span>

    <div class="constellation">
      <!-- Connecting lines: same viewBox units as the % node coords. -->
      <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline points={linePoints} />
      </svg>

      {stars.map((s, i) => (
        <div
          class={`node tone-${s.tone || "base"} align-${s.align}`}
          style={`left:${s.x}%; top:${s.y}%; --delay:${600 + i * 450}ms`}
        >
          <span class="star" style={`--size:${s.size}px`}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d={SUISEI_PATH} transform="translate(0 1.8)" />
            </svg>
          </span>
          <p class="node-text">{s.text}</p>
        </div>
      ))}
    </div>

    <nav class="void-nav">
      <a href="/write-letter" class="nav-link">write to me</a>
    </nav>
  </div>

  <script>
    function initAboutPage() {
      const c = document.querySelector<HTMLElement>(".constellation");
      if (!c) return;

      // Draw the connecting line in once.
      const line = c.querySelector<SVGPolylineElement>(".lines polyline");
      if (line) {
        const len = line.getTotalLength();
        line.style.strokeDasharray = `${len}`;
        line.style.strokeDashoffset = `${len}`;
        requestAnimationFrame(() => {
          line.style.transition = "stroke-dashoffset 2.4s ease 0.4s";
          line.style.strokeDashoffset = "0";
        });
      }

      // Uniform parallax on the whole group so stars + lines move together.
      document.addEventListener("mousemove", (e) => {
        const x = (e.clientX / window.innerWidth - 0.5) * 14;
        const y = (e.clientY / window.innerHeight - 0.5) * 14;
        c.style.transform = `translate(${x}px, ${y}px)`;
      });
    }

    document.addEventListener("DOMContentLoaded", initAboutPage);
    document.addEventListener("astro:page-load", initAboutPage);
  </script>
</BaseLayout>

<style>
  .void-page {
    min-height: 100vh;
    width: 100%;
    max-width: 100vw;
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  .page-label {
    position: fixed;
    top: 5rem;
    left: 2rem;
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    z-index: 10;
    pointer-events: none;
  }

  .constellation {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: transform 0.6s ease;
    will-change: transform;
  }

  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .lines polyline {
    fill: none;
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 0.12;
    vector-effect: non-scaling-stroke;
  }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: nodeIn 1.4s ease forwards;
    animation-delay: var(--delay);
    width: 0;
    height: 0;
  }

  @keyframes nodeIn {
    to { opacity: 1; }
  }

  .star {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.35));
    animation: twinkle 4s ease-in-out infinite;
    cursor: default;
  }

  .star svg { width: 100%; height: 100%; display: block; }
  .star path { fill: rgba(255, 255, 255, 0.95); }

  @keyframes twinkle {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.55)); }
  }

  /* Text floats below each star, dim until you hover the node. */
  .node-text {
    position: absolute;
    top: calc(var(--size, 24px) / 2 + 14px);
    width: 230px;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: 300;
    letter-spacing: 0.015em;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.5s ease, transform 0.5s ease;
  }

  .align-left .node-text   { left: 0; text-align: left; transform: translateX(-10%); }
  .align-center .node-text { left: 50%; text-align: center; transform: translateX(-50%); }
  .align-right .node-text  { right: 0; text-align: right; transform: translateX(10%); }

  .node:hover .node-text { color: rgba(255, 255, 255, 0.92); }
  .node:hover .star {
    animation: none;
    filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.8));
  }

  .tone-primary .node-text { font-size: 1.25rem; color: rgba(255, 255, 255, 0.7); }
  .tone-dim .node-text     { color: rgba(255, 255, 255, 0.32); }
  .tone-dimmer .node-text  { color: rgba(255, 255, 255, 0.26); }
  .tone-dimmest .node-text { color: rgba(255, 255, 255, 0.2); font-style: italic; }

  .void-nav {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    z-index: 10;
  }

  .nav-link {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.25);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 0.4s ease;
  }
  .nav-link:hover { color: rgba(255, 255, 255, 0.6); }

  .nav-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  /* ponytail: constellation needs 2D space; on narrow screens fall back to a
     simple centered stack instead of re-laying-out the star map. */
  @media (max-width: 768px) {
    .void-page { overflow-y: auto; }
    .constellation {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      padding: 6rem 1.5rem 7rem;
      transform: none !important;
    }
    .lines { display: none; }
    .node {
      position: relative;
      left: auto !important;
      top: auto !important;
      transform: none;
      width: 100%;
      height: auto;
      padding-left: 2.5rem;
      opacity: 1;
      animation: none;
    }
    .star { position: absolute; left: 1rem; top: 0.4rem; transform: none; width: 20px; height: 20px; }
    .node-text {
      position: relative;
      top: auto; left: auto !important; right: auto !important;
      width: 100%;
      text-align: left !important;
      transform: none !important;
    }
    .page-label {
      position: fixed; top: 1.5rem; left: 1.5rem;
      writing-mode: horizontal-tb; font-size: 0.65rem;
    }
    .void-nav { flex-direction: column; gap: 0.875rem; bottom: 1.25rem; }
    .nav-dot { display: none; }
  }
</style>
